
# ---- Assembly ----------------------------------------------------------------
rule spades:
    input:   left=lambda w:R1[w["group"]],
             right=lambda w:R2[w["group"]],
             sample_processing = expand("{path}/quality_done",path=IN)
    output:  assembly = "{group}/assembly/contigs.fasta", 
    params:  left = lambda w:" ".join([f"-1 {l}" for l in R1[w["group"]]]),
             right = lambda w:" ".join([f"-2 {l}" for l in R2[w["group"]]]),
             fold = "{group}/assembly"
    threads: 32
    resources:
        slurm_partition = get_resource("partition",mult=10),
        mem_mb = get_resource("mem",mult=10),
    log:     "{group}/assembly/spades.log"
    singularity: "docker://quay.io/biocontainers/spades:4.0.0--haf24da9_4"
    shell: """
        mem_gb=$(( {resources.mem_mb} / 1000 ))
        metaspades.py --meta --only-assembler -m "$mem_gb" -t {threads} {params.left} {params.right} -o {params.fold} &> {log}
    """
# Assemble with MegaHIT
rule megahit:
    input:   left=lambda w:R1[w["group"]],
             right=lambda w:R2[w["group"]],
             sample_processing= expand("{path}/quality_done",path=IN)
    output:  "{group}/assembly/final.contigs.fa"
    params:  left=lambda w: ",".join(R1[w["group"]]),
             right=lambda w: ",".join(R2[w["group"]]),
             fold ="{group}/assembly",
             Additional_params = ASSEMBLER_PARAMS,
    threads: 32
    resources:
        slurm_partition = get_resource("partition",mult=5),
        mem_mb = get_resource("mem",mult=5),
        # exclude = "n80546,n83030,n83032"
    log:     "{group}/assembly/assembly.log"
    conda : CONDA_ENV + "/megahit.yaml"
    singularity : "docker://quay.io/annacprice/megahit:1.2.9"
    shell:   """
             phymem=$(awk '/MemTotal/{{print $2}}' /proc/meminfo)
             mem=$(awk -v x={resources.mem_mb} -v y=$phymem 'BEGIN {{print (x * 1024) / y}}')
             megahit -1 {params.left} -2 {params.right} {params.Additional_params} -t {threads} -m $mem --continue -o {params.fold} -f &> {log}
             rm -rf {params.fold}/intermediate_contigs
             """

# HARD filter on max nb of contigs, I won't consider more than 70 000 000 by default due to bam max header size.
checkpoint contig_nb:
    input: lambda w:GROUP_ASM[w.group]
    output: "{group}/contigs/nb_contigs_init.tsv"
    run:
        with open(output[0],"w") as handle:
            handle.write("%s\n"%str(sum([1 for _,__ in sfp(open(input[0]))])))


def filter_contig_nb_or_not(w):
    nb_contig = int(open(checkpoints.contig_nb.get(group=w.group).output[0]).read().rstrip())
    if nb_contig>MAX_CONTIG_NB:
        return "%s/contigs/contigs_filtered.fa"%w.group
    else:
        return GROUP_ASM[w.group]

rule keep_biggest_contigs:
    input: lambda w:GROUP_ASM[w.group]
    output: "{group}/contigs/contigs_filtered.fa"
    resources:
        slurm_partition = get_resource("partition",min_size=20000),
        mem_mb=get_resource("mem")
    run:
        contig_len = {header:len(seq) for header,seq in sfp(open(input[0]))}
        sorted_lengths = sorted(contig_len.values())
        Length_min = next(el for el in sorted_lengths[-MAX_CONTIG_NB:] if el>sorted_lengths[MAX_CONTIG_NB])
        filered_contig = {contig for contig,l in contig_len.items() if l>Length_min}
        with open(output[0],"w") as handle:
            for header,seq in sfp(open(input[0])):
                if header in filered_contig:
                    handle.write(f">{header}\n{seq}\n")


if MIN_ASM_CONTIG_SIZE==0:
    rule symlink_asm:
        input: filter_contig_nb_or_not
        output: "{group}/contigs/contigs.fa"
        shell: """
        ln -sfn $(realpath {input}) $(realpath {output})
        touch -h "{output}"
        """
else:
    rule filter_contigs:
        input: filter_contig_nb_or_not
        output: "{group}/contigs/contigs.fa"
        run:
            with open(output[0],"w") as handle:
                for header,seq in sfp(open(input[0])):
                    if len(seq)>=MIN_ASM_CONTIG_SIZE:
                        handle.write(f">{header}\n{seq}\n")



# ---- bwa index file  -------------------------------------------
rule bwa_index:
    input:   "{path}/contigs.fa"
    output:  touch("{path}/index.done")
    log:     "{path}/index.log"
    params : 10000000000
    resources:
        slurm_partition = get_resource("partition"),
        mem_mb=get_resource("mem")
    message: "Building bwa index for {input}"
    singularity: "docker://quay.io/annacprice/bwasamtools:1.10"
    shell:   "bwa index -b {params} {input} &> {log}"

# ---- map reads to the assembly contigs--------------------------------------------------
rule samtool_index:
    input: "{path}.fa"
    output: "{path}.fa.fai"
    resources:
        slurm_partition = get_resource("partition"),
        mem_mb=get_resource("mem")    
    singularity: "docker://quay.io/biocontainers/samtools:1.22.1--h96c455f_0"
    shell: "samtools faidx {input}"


rule bwa_mem:
    input:   index="{group}/contigs/index.done",
             contigs="{group}/contigs/contigs.fa",
             asm_index = "{group}/contigs/contigs.fa.fai",
             shedule = schedule_mapping # makes read mapping happens with only 1 asm at a time
    params: left=lambda w:replace_extensions(SAMPLE_READS[w.sample][0],FILTER), # read in params to better control partition/mem
            right=lambda w:replace_extensions(SAMPLE_READS[w.sample][1],FILTER)
    output:  pipe("{group}/map/{sample}.sam")
    threads: 10
    resources:
        slurm_partition = get_resource("partition", mult=10),
        mem_mb = get_resource("mem", mult=10),
    log:     "{group}/map/{sample}_map.log"
    message: "bwa mem mapping followed by samtool sorting for {input}"
    singularity: "docker://quay.io/biocontainers/bwa:0.7.19--h577a1d6_1"
    shell:   "bwa mem -t {threads} {input.contigs} {params.left} {params.right} 2>{log} > {output}"

rule sam_to_bam:
    input:   sam = "{group}/map/{sample}.sam",
    output:  temp("{group}/map/{sample}_mapped_sorted.bam")
    threads: 4
    resources:
        slurm_partition = get_resource("partition", mult=4),
        mem_mb = get_resource("mem", mult=4),
    message: "samtool sorting for {input}"
    singularity: "docker://quay.io/biocontainers/samtools:1.22.1--h96c455f_0"
    shell:   "samtools view -b -F 4 -@{threads} {input.sam} | samtools sort -@{threads} - > {output} "

